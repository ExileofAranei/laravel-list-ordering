includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        # database/factories/.gitkeep keeps this directory present on a
        # fresh checkout (git does not track empty directories) — without
        # it, this path does not exist and PHPStan fails before analysing
        # a single file.
        - database
    tmpDir: build/phpstan
    ignoreErrors:
        -
            # Concern and Testing traits are consumed by classes in a package's
            # *consuming* application (a model, or the consumer's own test
            # case), which this repo's own analysis never sees — only by the
            # fixtures under tests/, which aren't in `paths` above (Pest's
            # fluent test API isn't statically analysable without dedicated
            # tooling this package doesn't install). "Unused" here is a
            # structural false positive for any public-API trait, not a real
            # dead-code signal.
            identifier: trait.unused
            paths:
                - src/Concerns/*.php
                - src/Testing/*.php
